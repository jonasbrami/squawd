# The supported Claude launcher uses the host CLI OAuth credential copy, not
# ANTHROPIC_API_KEY. Set an API key only for a separate direct-SDK workflow.
#ANTHROPIC_API_KEY=sk-ant-...
# Kimi Code subscription key (https://www.kimi.com/code console) — used when
# SQUAWD_BACKEND=kimi; leave unset for Claude OAuth (Kimi tier skipped)
KIMI_API_KEY=sk-kimi-...
# LLM backend for the pilot: codex (ChatGPT login) | kimi (subscription) |
# claude (OAuth). The launcher copies only the selected login artifact into an
# isolated runtime home; it never mounts your full Codex/Claude configuration.
# Kimi tier note (R5): the SDK's bundled CLI ignores ANTHROPIC_BASE_URL (#677),
# so the EXTERNAL `claude` CLI must be on PATH — make_pilot_options hard-fails
# with a legible error otherwise (cli_path is enforced, not a fallback).
SQUAWD_BACKEND=claude
# MAVSDK connection to PX4 SITL (PX4 offboard API port)
SQUAWD_CONNECTION_URL=udpin://0.0.0.0:14540
# Optional provider-specific override. Leave unset to use the selected
# backend's compatibility default; a Claude model name is not valid on Kimi or
# Codex.
#SQUAWD_MODEL=claude-opus-4-8
# Codex tier: uses ~/.codex/auth.json from `codex login`, not OPENAI_API_KEY.
# Defaults are gpt-5.6-terra and low effort when these are unset.
#SQUAWD_BACKEND=codex
#SQUAWD_MODEL=gpt-5.6-terra
#SQUAWD_CODEX_EFFORT=low
# Kimi tier: use k3-256k (lightest K3 — half the quota of k3-1M, same quality
# within 256k ctx). Thinking effort is pinned to low in kimi_recipe()
# (SQUAWD_KIMI_EFFORT overrides); disabling thinking entirely routes to K2.6.
#SQUAWD_MODEL=k3-256k

# Demo/perception selection. The supported demo explicitly overrides to v2;
# run_single_demo.sh still defaults the demo world to the v1 640 export.
#VISION_MODEL=coco-nano-seg-v2-640.onnx
#VISION_BACKEND=onnx
#RENDER_BACKEND=intel

# Optional host-GPU deep lane. scripts/deep_perception.sh creates .deep_token;
# run_single_demo.sh passes it and this endpoint into the container.
#DEEP_PERCEPTION_URL=http://host.docker.internal:8100
#DEEP_SLOWLANE=on
#DEEP_SLOWLANE_HZ=0.3
#DEEP_SLOWLANE_VOCAB=building,house,tree,pole,tower
#DEEP_SLOWLANE_CONF=0.05
