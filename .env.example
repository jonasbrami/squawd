ANTHROPIC_API_KEY=sk-ant-...
# Kimi Code subscription key (https://www.kimi.com/code console) — used when
# SQUAWD_BACKEND=kimi; leave unset for Claude OAuth (Kimi tier skipped)
KIMI_API_KEY=sk-kimi-...
# LLM backend for the pilot: claude (OAuth from ~/.claude) | kimi (subscription).
# Kimi tier note (R5): the SDK's bundled CLI ignores ANTHROPIC_BASE_URL (#677),
# so the EXTERNAL `claude` CLI must be on PATH — make_pilot_options hard-fails
# with a legible error otherwise (cli_path is enforced, not a fallback).
SQUAWD_BACKEND=claude
# MAVSDK connection to PX4 SITL (PX4 offboard API port)
SQUAWD_CONNECTION_URL=udpin://0.0.0.0:14540
SQUAWD_MODEL=claude-opus-4-8
